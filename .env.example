# Copy to .env and fill in. Never commit .env.

# --- Application ---------------------------------------------------------------
ENVIRONMENT=local                # local | test | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                   # true in containers (machine-readable), false for local reading
API_PREFIX=/api/v1

# --- Database: Neon serverless PostgreSQL ----------------------------------------
# Copy both strings from Neon Console > Connect (or `neon connection-string`).
# Pooled endpoint (host contains "-pooler"): used by the API and workers.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct endpoint (no "-pooler"): used by Alembic migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Without Neon you can develop against SQLite (this is also the default if unset):
# DATABASE_URL=sqlite:///./data/researchpilot.db

# --- Redis -----------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ----------------------------------------------------------------------
# http(s) URL for a server, ":memory:" for in-process, or a folder path for embedded local mode.
QDRANT_LOCATION=http://localhost:6333
# QDRANT_LOCATION=./data/qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION=researchpilot_chunks

# --- LLM (Groq) ------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
# Reasoning effort for reasoning models (gpt-oss/qwen3); leave empty for other models
LLM_REASONING_EFFORT_SYNTHESIS=medium
LLM_REASONING_EFFORT_DEFAULT=low
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
GROQ_API_KEY=

# --- Embeddings / reranking ------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=16

# --- Retrieval -------------------------------------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=30
RERANK_CANDIDATE_K=10
RRF_K=60
MAX_QUERY_VARIANTS=4
# Keep downloaded models on the project drive instead of the user profile:
HF_HOME=./.cache/hf
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Ingestion -------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_UPLOAD=10
MAX_PDF_PAGES=500
INDEX_REFERENCES=false
# Keep temporary upload spool files on the project drive:
TEMP_DIR=./.cache/tmp
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=50

# --- Research workflow (LangGraph) ---------------------------------------------
RESEARCH_DEFAULT_STRATEGY=hybrid_rerank
RESEARCH_MAX_RETRIEVAL_RETRIES=1
RESEARCH_MAX_REPAIR_ATTEMPTS=1
RESEARCH_EVIDENCE_K_SIMPLE=6
RESEARCH_EVIDENCE_K_COMPLEX=10
RESEARCH_TIMEOUT_SECONDS=300
# Pause before nodes for human review, JSON list, e.g. ["synthesize"]
RESEARCH_INTERRUPT_BEFORE=[]
RESEARCH_CHECKPOINTER=postgres
# Optional cost tracking, USD per 1M tokens (verify on your provider's pricing page):
# LLM_PRICING={"openai/gpt-oss-120b": {"input": 0.15, "output": 0.60}}

# --- Background tasks ------------------------------------------------------------
# celery = separate worker via Redis (production); inline = run inside the API (no Redis needed)
TASK_BACKEND=celery
CELERY_BROKER_POLLING_INTERVAL=10
INGESTION_MAX_RETRIES=3

# --- LangSmith (optional; tracing is off unless enabled) -------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=researchpilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
